{
  "name": "@nimesko/simple-tic-tac-toe",
  "version": "1.0.0",
  "private": true,
  "description": "A simple Tic Tac Toe game with ranking, playable with keyboard with sound assist",
  "keywords": [
    "tic-tac-toe",
    "game",
    "react",
    "typescript",
    "vite",
    "styled-components",
    "keyboard",
    "ranking"
  ],
  "homepage": "https://github.com/nimesko/simple-tic-tac-toe#readme",
  "bugs": {
    "url": "https://github.com/nimesko/simple-tic-tac-toe/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimesko/simple-tic-tac-toe.git"
  },
  "license": "MIT",
  "author": {
    "name": "Rogério Tristão Junior",
    "email": "rogerio.junior@outlook.com",
    "url": "https://github.com/nimesko"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src index.html vite.config.mts eslint.config.mjs",
    "format:check": "prettier --check src index.html vite.config.mts eslint.config.mjs",
    "test:a11y": "vitest run src/__tests__/a11y.test.tsx src/theme/__tests__/contrast.test.ts --coverage.enabled=false"
  },
  "dependencies": {
    "kebab-case": "^1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.91.0",
    "react-is": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "styled-components": "^6.6.0",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
