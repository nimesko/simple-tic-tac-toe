{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "jsx": "react",
        "moduleResolution": "bundler",
        "sourceMap": true,
        "noEmit": true,
        "types": ["vite/client", "vitest/globals", "node"],
        "strict": true,
        "allowJs": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "experimentalDecorators": true,
        "paths": {
            "@models/*": ["./src/models/*"],
            "@components/*": ["./src/components/*"],
            "@utils/*": ["./src/utils/*"],
            "@reducers/*": ["./src/reducers/*"],
            "@services/*": ["./src/services/*"],
                "@theme/*": ["./src/theme/*"]
        }
    },
    "exclude": [
        "node_modules"
    ]
}